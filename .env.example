# Cấu hình WebRTC Group Call Server
# Copy file này thành .env và chỉnh sửa theo môi trường của bạn

# ===== SERVER CONFIG =====
# Port server chạy
PORT=3000

# Host (0.0.0.0 để lắng nghe tất cả interfaces)
HOST=0.0.0.0

# Đường dẫn đến SSL certificates
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

METERED_TURN_USERNAME=your-metered-username
METERED_TURN_CREDENTIAL=your-metered-credential


