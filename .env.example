# Cấu hình WebRTC Group Call Server
# Copy file này thành .env và chỉnh sửa theo môi trường của bạn

# ===== SERVER CONFIG =====
# Port server chạy
PORT=3000

# Host (0.0.0.0 để lắng nghe tất cả interfaces)
HOST=0.0.0.0

# ===== SSL CERTIFICATES =====
# Đường dẫn đến SSL certificates
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

# ===== TURN SERVER CONFIG =====
# Cấu hình TURN server (coturn hoặc dịch vụ TURN khác)
# Uncomment và điền thông tin khi triển khai TURN server

# TURN_SERVER_HOST=your-turn-server.com
# TURN_SERVER_PORT=3478
# TURN_SECURE_PORT=5349
# TURN_USERNAME=your-username
# TURN_PASSWORD=your-password

# ===== COTURN LOCAL CONFIG =====
# Nếu chạy coturn local (Docker), sử dụng các giá trị này:
# TURN_SERVER_HOST=localhost
# TURN_SERVER_PORT=3478
# TURN_SECURE_PORT=5349
# TURN_USERNAME=webrtc
# TURN_PASSWORD=webrtc123
